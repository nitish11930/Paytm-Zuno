# Copy to privacy/sarvam.env; never put a real key into a VITE_ variable.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
PORT=5187
# Local demo only. Deployment requires real identity, TLS and operational review.

# Optional deployment origin; exact HTTPS origin only, no trailing slash/path.
# APP_ORIGIN=https://munim.example
# Maximum attempted provider calls per UTC day (persistent counter, not a rupee cap).
SARVAM_DAILY_CALL_LIMIT=500
