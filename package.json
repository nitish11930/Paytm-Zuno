{
  "name": "zuno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "format": "prettier --write src server tests scripts vite.config.js",
    "format:check": "prettier --check src server tests scripts vite.config.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "android:check": "node scripts/build-apk.mjs --compile-check",
    "android:build": "node scripts/build-apk.mjs",
    "supabase:check": "node scripts/supabase.mjs check",
    "supabase:schema": "node scripts/supabase.mjs schema",
    "supabase:migrate": "node scripts/migrate-to-supabase.mjs",
    "supabase:verify": "node scripts/migrate-to-supabase.mjs --verify"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.4.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supertest": "^7.1.0"
  }
}
